{
  "build": {
    "arduino": {
      "ldscript": "esp32_out.ld"
    },
    "core": "esp32",
    "extra_flags": "-DARDUINO_TELLOESP32_DEV",
    "f_cpu": "160000000L",
    "f_flash": "40000000L",
    "flash_mode": "dio",
    "mcu": "esp32",
    "variant": "telloesp32"
  },

  "connectivity": [
    "wifi",
    "bluetooth"
  ],

  "debug": {
    "openocd_target": "esp32.cfg"
  },

  "frameworks": [
    "arduino"
  ],

  "name": "RoboMaster TT ESP32",

  "upload": {
    "flash_size": "2MB",
    "maximum_ram_size": 327680,
    "maximum_size": 1310720,
    "protocol": "esptool",
    "require_upload_port": true,
    "speed": 115200
  },

  "url": "https://www.dji.com/robomaster-tt",

  "vendor": "DJI"
}